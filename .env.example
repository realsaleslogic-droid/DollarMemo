# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://<your-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx"   # publishable / anon key (public-safe)

# Supabase service-role key — Project Settings -> API -> service_role.
# SERVER-ONLY SECRET. Never expose to the client / never prefix with NEXT_PUBLIC_.
# Used to read/write the plaid_items table, which holds bank access tokens the
# browser must never see.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# Plaid — https://dashboard.plaid.com -> Team Settings -> Keys
PLAID_CLIENT_ID="your_plaid_client_id"
PLAID_SECRET="your_plaid_secret"          # the secret for the PLAID_ENV below
PLAID_ENV="sandbox"                        # sandbox | production (develop in sandbox first)
PLAID_PRODUCTS="transactions"              # comma-separated Plaid products
PLAID_COUNTRY_CODES="US"                   # comma-separated ISO country codes
# Optional: public base URL Plaid calls for webhooks (e.g. https://yourapp.com).
# Leave blank in local dev; set in production to enable background transaction sync.
PLAID_WEBHOOK_URL=""
# Optional: shared secret to verify incoming Plaid webhooks (any random string).
PLAID_WEBHOOK_SECRET=""

# 32-byte key (base64 or hex) used to encrypt Plaid access tokens at rest.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""
