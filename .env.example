# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://<your-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx"   # publishable / anon key (public-safe)

# Supabase service-role key — Project Settings -> API -> service_role.
# SERVER-ONLY SECRET. Never expose to the client / never prefix with NEXT_PUBLIC_.
# Used to read/write the stripe_accounts table.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# Stripe — https://dashboard.stripe.com/apikeys
# Bank linking uses Stripe Financial Connections (enable it in the dashboard).
STRIPE_SECRET_KEY="sk_test_xxx"                              # SERVER-ONLY secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"            # public-safe, used by Stripe.js

# Stripe Billing webhook signing secret — Dashboard -> Developers -> Webhooks.
# Add an endpoint for {your-url}/api/stripe/webhook (events: checkout.session.completed,
# customer.subscription.created/updated/deleted) and paste its signing secret here.
STRIPE_WEBHOOK_SECRET="whsec_xxx"
